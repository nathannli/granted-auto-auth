#!/usr/bin/env python3

from __future__ import annotations

import ctypes
import contextlib
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

if os.name == "nt":
    if str(Path(__file__).resolve().parent) not in sys.path:
        sys.path.insert(0, str(Path(__file__).resolve().parent))
    import granted_auto_windows as windows


PLAYWRIGHT_VERSION = "1.62.0"
CONTROLLER = Path(__file__).resolve()
SCRIPTS_DIR = CONTROLLER.parent
SIDECAR = SCRIPTS_DIR / "granted_auto_auth.py"
LOCKFILE = SCRIPTS_DIR / "granted_auto_auth.py.lock"
SUPERVISOR = SCRIPTS_DIR / "granted_auto_auth_supervisor.py"
SUPERVISOR_LOCKFILE = SCRIPTS_DIR / "granted_auto_auth_supervisor.py.lock"
STATE_DIR = Path.home() / ".config/granted-auto-auth"
STATE_FILE = STATE_DIR / "install.toml"
CREDENTIALS_FILE = STATE_DIR / "credentials.toml"
GRANTED_CONFIG = Path.home() / ".granted/config"
AWS_CONFIG = Path.home() / ".aws/config"
KEYRING_DIR = Path.home() / ".local/share/granted-auto-auth/granted-keyring"
TRANSACTION_LOCK = STATE_DIR / "locks/install.lock"
KEYRING_CREDENTIAL_TARGET = "granted-auto-auth/file-keyring-password/v1"
CONTAINER_MARKER = Path("/.dockerenv")
OS_RELEASE = Path("/etc/os-release")
PROC_ROOT = Path("/proc")


class ControllerError(Exception):
    pass


def _validate_file(path: Path, result: os.stat_result, allowed_mode: int = 0o600) -> None:
    if not stat.S_ISREG(result.st_mode):
        raise ControllerError(f"{path.name} is not a regular file")
    if result.st_uid != os.getuid():
        raise ControllerError(f"{path.name} owner is invalid")
    if stat.S_IMODE(result.st_mode) & ~allowed_mode:
        raise ControllerError(f"{path.name} permissions are too permissive")


def read_secure_toml(path: Path) -> dict[str, object]:
    if os.name == "nt":
        try:
            return tomllib.loads(windows.read_secure_bytes(path).decode())
        except UnicodeDecodeError as error:
            raise ControllerError(f"unable to read {path.name}") from error
    parent = os.lstat(path.parent)
    if stat.S_ISLNK(parent.st_mode) or not stat.S_ISDIR(parent.st_mode):
        raise ControllerError(f"{path.parent.name} is not a real directory")
    if parent.st_uid != os.getuid() or stat.S_IMODE(parent.st_mode) & ~0o700:
        raise ControllerError(f"{path.parent.name} permissions are too permissive")
    before = os.lstat(path)
    if stat.S_ISLNK(before.st_mode):
        raise ControllerError(f"{path.name} must not be a symlink")
    _validate_file(path, before)
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        after = os.fstat(descriptor)
        _validate_file(path, after)
        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
            raise ControllerError(f"{path.name} changed while opening")
        with os.fdopen(os.dup(descriptor), "rb") as stream:
            return tomllib.load(stream)
    finally:
        os.close(descriptor)


def _toml_value(value: object) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str):
        return json.dumps(value)
    raise TypeError(f"unsupported state type: {type(value).__name__}")


def write_state(values: dict[str, object]) -> None:
    if os.name == "nt":
        data = "".join(f"{key} = {_toml_value(value)}\n" for key, value in values.items()).encode()
        windows.write_secure_bytes(STATE_FILE, data)
        return
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE_DIR, 0o700)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".install.", suffix=".tmp", dir=STATE_DIR)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        data = "".join(f"{key} = {_toml_value(value)}\n" for key, value in values.items()).encode()
        os.write(descriptor, data)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.replace(temporary, STATE_FILE)
        directory_descriptor = os.open(STATE_DIR, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def granted_config() -> dict[str, object]:
    try:
        if os.name == "nt":
            return tomllib.loads(windows.read_secure_bytes(GRANTED_CONFIG).decode())
        with GRANTED_CONFIG.open("rb") as stream:
            return tomllib.load(stream)
    except (FileNotFoundError, tomllib.TOMLDecodeError) as error:
        raise ControllerError("unable to read Granted config") from error


def custom_sso_browser_path() -> str:
    value = granted_config().get("CustomSSOBrowserPath", "")
    if not isinstance(value, str):
        raise ControllerError("Granted CustomSSOBrowserPath is invalid")
    return value


def run_checked(arguments: list[str], *, capture: bool = False) -> subprocess.CompletedProcess[str]:
    environment = os.environ.copy()
    environment["GRANTED_ALIAS_CONFIGURED"] = "true"
    try:
        return subprocess.run(
            arguments,
            check=True,
            text=True,
            capture_output=capture,
            env=environment,
        )
    except (FileNotFoundError, subprocess.CalledProcessError) as error:
        raise ControllerError(f"command failed: {Path(arguments[0]).name}") from error


def _windows_executable(path: Path) -> bool:
    return path.is_file() and (os.name == "nt" or os.access(path, os.X_OK))


def _windows_uv_path() -> str:
    value = os.environ.get("GRANTED_AUTO_AUTH_UV", "") or shutil.which("uv.exe") or shutil.which("uv") or ""
    if not value:
        raise ControllerError("uv.exe is missing; install uv, then run: granted-auto-auth install")
    try:
        result = windows.canonical_path(value)
    except OSError as error:
        raise ControllerError("uv.exe path is invalid") from error
    if Path(result).name.lower() != "uv.exe":
        raise ControllerError("resolved uv executable is invalid")
    return result


def _windows_launch_command(uv_path: str) -> str:
    return f'"{uv_path}" run --script --locked --offline "{windows.canonical_path(SIDECAR)}" "{{{{.URL}}}}"'


def _config_snapshot() -> tuple[bytes, str]:
    data = windows.read_secure_bytes(GRANTED_CONFIG)
    return data, hashlib.sha256(data).hexdigest()


def _owned_config_fragments(data: bytes) -> tuple[str, str, str]:
    try:
        text = data.decode()
    except UnicodeDecodeError as error:
        raise ControllerError("Granted config must be UTF-8") from error
    custom = re.search(r"(?m)^CustomSSOBrowserPath\s*=.*(?:\r?\n|\Z)", text)
    template = re.search(r"(?ms)^\[SSOBrowserLaunchTemplate\]\s*\r?\n.*?(?=^\[|\Z)", text)
    keyring = re.search(r"(?ms)^\[Keyring\]\s*\r?\n.*?(?=^\[|\Z)", text)
    return (
        custom.group(0) if custom else "",
        template.group(0) if template else "",
        keyring.group(0) if keyring else "",
    )


def _patch_owned_config(data: bytes, custom_fragment: str, template_fragment: str, keyring_fragment: str) -> bytes:
    try:
        text = data.decode()
    except UnicodeDecodeError as error:
        raise ControllerError("Granted config must be UTF-8") from error
    text = re.sub(r"(?m)^CustomSSOBrowserPath\s*=.*(?:\r?\n|\Z)", "", text)
    text = re.sub(r"(?ms)^\[SSOBrowserLaunchTemplate\]\s*\r?\n.*?(?=^\[|\Z)", "", text)
    text = re.sub(r"(?ms)^\[Keyring\]\s*\r?\n.*?(?=^\[|\Z)", "", text)
    newline = "\r\n" if "\r\n" in text else "\n"
    additions = ""
    if custom_fragment:
        additions += custom_fragment.rstrip("\r\n") + newline
    if template_fragment:
        additions += template_fragment.rstrip("\r\n") + newline
    if keyring_fragment:
        additions += keyring_fragment.rstrip("\r\n") + newline
    if additions:
        text = text.rstrip("\r\n") + newline + additions
    return text.encode()


def _installed_template(command: str, newline: str = "\n") -> str:
    return (
        f"[SSOBrowserLaunchTemplate]{newline}"
        f"Command = {json.dumps(command)}{newline}"
        f"UseForkProcess = false{newline}"
    )


def _installed_keyring(file_dir: str, newline: str = "\n") -> str:
    return (
        f"[Keyring]{newline}"
        f"Backend = \"file\"{newline}"
        f"FileDir = {json.dumps(file_dir)}{newline}"
    )


def _windows_settings() -> tuple[str, dict[str, object] | None, dict[str, object] | None]:
    config = granted_config()
    custom = config.get("CustomSSOBrowserPath", "")
    template = config.get("SSOBrowserLaunchTemplate")
    keyring = config.get("Keyring")
    if not isinstance(custom, str):
        raise ControllerError("Granted CustomSSOBrowserPath is invalid")
    if template is not None and not isinstance(template, dict):
        raise ControllerError("Granted SSOBrowserLaunchTemplate is invalid")
    if keyring is not None and not isinstance(keyring, dict):
        raise ControllerError("Granted Keyring is invalid")
    return custom, template, keyring


def _windows_template_matches(command: str) -> bool:
    try:
        custom, template, _ = _windows_settings()
    except ControllerError:
        return False
    return (
        custom == ""
        and isinstance(template, dict)
        and template.get("Command") == command
        and template.get("UseForkProcess", False) is False
    )


def _windows_keyring_matches(file_dir: str) -> bool:
    try:
        _, _, keyring = _windows_settings()
        configured = str(keyring.get("FileDir", "")) if isinstance(keyring, dict) else ""
        return (
            isinstance(keyring, dict)
            and set(keyring) == {"Backend", "FileDir"}
            and keyring.get("Backend") == "file"
            and windows.canonical_path(configured) == file_dir
        )
    except (ControllerError, OSError):
        return False


def _windows_owned_settings_match(command: str, file_dir: str) -> bool:
    return _windows_template_matches(command) and _windows_keyring_matches(file_dir)


def _windows_keyring_migration_allowed() -> bool:
    _, _, keyring = _windows_settings()
    if keyring is None:
        return True
    return set(keyring) <= {"Backend"} and keyring.get("Backend", "") in {"", "wincred"}


def _windows_base_state(
    data: bytes, fingerprint: str, command: str, uv_path: str, file_dir: str, directory_created: bool,
) -> dict[str, object]:
    custom, template, keyring = _owned_config_fragments(data)
    return {
        "phase": "prepared",
        "previous_custom_fragment": custom,
        "previous_template_fragment": template,
        "previous_keyring_fragment": keyring,
        "installed_launch_template": command,
        "installed_keyring_dir": file_dir,
        "keyring_credential_target": KEYRING_CREDENTIAL_TARGET,
        "keyring_credential_created": False,
        "keyring_credential_hash": "",
        "keyring_dir_created": directory_created,
        "config_fingerprint": fingerprint,
        "executable_path": str(SIDECAR),
        "supervisor_path": str(SCRIPTS_DIR / "granted_auto_auth_supervisor.py"),
        "uv_path": uv_path,
        "chromium_path": "",
        "playwright_version": PLAYWRIGHT_VERSION,
        "chromium_revision": "",
    }


def _windows_restore_config(state: dict[str, object], *, require_installed: bool) -> None:
    current, fingerprint = _config_snapshot()
    command = state.get("installed_launch_template")
    if not isinstance(command, str):
        raise ControllerError("installed launch template is invalid")
    file_dir = state.get("installed_keyring_dir")
    if not isinstance(file_dir, str):
        raise ControllerError("installed keyring directory is invalid")
    installed = _windows_owned_settings_match(command, file_dir)
    expected_fingerprint = state.get("config_fingerprint")
    if require_installed and not installed:
        raise ControllerError("refusing to overwrite unrelated Granted browser setting")
    if not require_installed and not installed and fingerprint != expected_fingerprint:
        raise ControllerError("partial install conflicts with newer Granted config")
    custom = state.get("previous_custom_fragment")
    template = state.get("previous_template_fragment")
    keyring = state.get("previous_keyring_fragment")
    if not isinstance(custom, str) or not isinstance(template, str) or not isinstance(keyring, str):
        raise ControllerError("saved Granted settings are invalid")
    windows.write_secure_bytes(GRANTED_CONFIG, _patch_owned_config(current, custom, template, keyring))


@contextlib.contextmanager
def _windows_transaction():
    windows.ensure_restricted_directory(STATE_DIR)
    windows.ensure_restricted_file(TRANSACTION_LOCK)
    lock = windows.lock_file(TRANSACTION_LOCK, time.monotonic_ns(), "installation transaction")
    try:
        yield
    finally:
        windows.unlock_file(*lock)


def _windows_prepare_keyring_directory() -> tuple[str, bool]:
    created = not KEYRING_DIR.exists()
    windows.ensure_restricted_directory(KEYRING_DIR)
    return windows.canonical_path(KEYRING_DIR), created


def _windows_keyring_directory_empty() -> bool:
    handle = windows.secure_open(KEYRING_DIR, directory=True)
    try:
        return next(KEYRING_DIR.iterdir(), None) is None
    finally:
        windows.close_handle(handle)


def _windows_prepare_keyring_credential(state: dict[str, object], *, allow_existing: bool) -> None:
    if state.get("keyring_credential_target") != KEYRING_CREDENTIAL_TARGET:
        raise ControllerError("managed Windows credential target is invalid")
    value = windows.credential_read(KEYRING_CREDENTIAL_TARGET)
    expected_hash = state.get("keyring_credential_hash", "")
    if value is not None:
        actual_hash = hashlib.sha256(value.encode()).hexdigest()
        if not allow_existing or not isinstance(expected_hash, str) or actual_hash != expected_hash:
            raise ControllerError("managed Windows credential exists without matching install ownership")
        return
    if not _windows_keyring_directory_empty():
        raise ControllerError("managed keyring password is missing while encrypted cache is nonempty; restore the credential")
    value = windows.generate_keyring_password()
    state["keyring_credential_hash"] = hashlib.sha256(value.encode()).hexdigest()
    state["phase"] = "storage_prepared"
    write_state(state)
    windows.credential_create(value, KEYRING_CREDENTIAL_TARGET)
    state["keyring_credential_created"] = True
    write_state(state)


def _windows_cleanup_new_storage(state: dict[str, object]) -> None:
    expected_hash = state.get("keyring_credential_hash", "")
    value = windows.credential_read(KEYRING_CREDENTIAL_TARGET)
    transaction_owned = state.get("keyring_credential_created") or state.get("phase") == "storage_prepared"
    if transaction_owned and value is not None and isinstance(expected_hash, str) and hashlib.sha256(value.encode()).hexdigest() == expected_hash:
        windows.credential_delete(KEYRING_CREDENTIAL_TARGET)
    if state.get("keyring_dir_created") and KEYRING_DIR.exists() and _windows_keyring_directory_empty():
        KEYRING_DIR.rmdir()


def _windows_enabled() -> bool:
    try:
        state = read_secure_toml(STATE_FILE)
        command = str(state.get("installed_launch_template", ""))
        chromium = str(state.get("chromium_path", ""))
        revision = str(state.get("chromium_revision", ""))
        supervisor = Path(str(state.get("supervisor_path", "")))
        file_dir = str(state.get("installed_keyring_dir", ""))
        credential = windows.credential_read(KEYRING_CREDENTIAL_TARGET)
        credential_hash = str(state.get("keyring_credential_hash", ""))
        directory = windows.secure_open(KEYRING_DIR, directory=True)
        windows.close_handle(directory)
        return all((
            state.get("phase") == "configured",
            state.get("playwright_version") == PLAYWRIGHT_VERSION,
            state.get("uv_path") == _windows_uv_path(),
            state.get("executable_path") == str(SIDECAR),
            supervisor == SCRIPTS_DIR / "granted_auto_auth_supervisor.py",
            supervisor.is_file(),
            supervisor.with_suffix(".py.lock").is_file(),
            SIDECAR.is_file(), LOCKFILE.is_file(),
            state.get("keyring_credential_target") == KEYRING_CREDENTIAL_TARGET,
            bool(credential), hashlib.sha256(str(credential).encode()).hexdigest() == credential_hash,
            windows.canonical_path(KEYRING_DIR) == file_dir,
            _windows_owned_settings_match(command, file_dir),
            bool(revision), f"chromium-{revision}" in chromium,
            Path(chromium).is_file(),
            not platform_health(),
        ))
    except (ControllerError, FileNotFoundError, PermissionError, tomllib.TOMLDecodeError, OSError):
        return False


def _windows_prepare_browser_state() -> None:
    root = Path.home() / ".local/share/granted-auto-auth"
    browser = root / "browser"
    windows.ensure_restricted_directory(root)
    windows.ensure_restricted_directory(browser)
    windows.write_secure_bytes(root / "browser.lock", b"")


def _windows_apply_install_config(
    state: dict[str, object], command: str, file_dir: str, expected_fingerprint: str,
) -> None:
    current, current_fingerprint = _config_snapshot()
    if current_fingerprint != expected_fingerprint:
        raise ControllerError("Granted config changed during install")
    newline = "\r\n" if b"\r\n" in current else "\n"
    updated = _patch_owned_config(
        current, "", _installed_template(command, newline), _installed_keyring(file_dir, newline)
    )
    windows.write_secure_bytes(GRANTED_CONFIG, updated)
    if not _windows_owned_settings_match(command, file_dir):
        raise ControllerError("Granted browser or keyring settings did not persist")
    state["phase"] = "configured"
    state["installed_launch_template"] = command
    state["config_fingerprint"] = hashlib.sha256(updated).hexdigest()
    write_state(state)


def _windows_resynchronize_configured(state: dict[str, object]) -> None:
    previous_state = dict(state)
    installed = state.get("installed_launch_template")
    uv_path = _windows_uv_path()
    command = _windows_launch_command(uv_path)
    if not isinstance(installed, str) or not (
        _windows_template_matches(installed) or _windows_template_matches(command)
    ):
        raise ControllerError("configured Windows install does not own current Granted settings")
    before, original_fingerprint = _config_snapshot()
    migration = "installed_keyring_dir" not in state
    try:
        if migration:
            if not _windows_keyring_migration_allowed():
                raise ControllerError("configured Windows install does not own current Granted keyring settings")
            _, _, previous_keyring = _owned_config_fragments(before)
            file_dir, directory_created = _windows_prepare_keyring_directory()
            state.update(
                phase="prepared",
                previous_keyring_fragment=previous_keyring,
                installed_keyring_dir=file_dir,
                keyring_credential_target=KEYRING_CREDENTIAL_TARGET,
                keyring_credential_created=False,
                keyring_credential_hash="",
                keyring_dir_created=directory_created,
                config_fingerprint=original_fingerprint,
            )
            write_state(state)
            _windows_prepare_keyring_credential(state, allow_existing=False)
        else:
            file_dir = str(state.get("installed_keyring_dir", ""))
            if not file_dir or state.get("keyring_credential_target") != KEYRING_CREDENTIAL_TARGET:
                raise ControllerError("configured Windows keyring install state is invalid")
            if not _windows_keyring_matches(file_dir):
                raise ControllerError("configured Windows install does not own current Granted keyring settings")
            windows.ensure_restricted_directory(KEYRING_DIR)
            if windows.canonical_path(KEYRING_DIR) != file_dir:
                raise ControllerError("configured Windows keyring directory changed")
            _windows_prepare_keyring_credential(state, allow_existing=True)
            state["phase"] = "configured"
            write_state(state)
        chromium, revision = provision_chromium()
        _, fingerprint = _config_snapshot()
        state.update(
            executable_path=str(SIDECAR),
            supervisor_path=str(SUPERVISOR),
            uv_path=uv_path,
            installed_launch_template=command,
            chromium_path=chromium,
            chromium_revision=revision,
            playwright_version=PLAYWRIGHT_VERSION,
            config_fingerprint=fingerprint,
        )
        write_state(state)
        if not _windows_owned_settings_match(command, file_dir):
            _windows_apply_install_config(state, command, file_dir, fingerprint)
        if not _windows_enabled():
            raise ControllerError("Windows install resynchronization did not restore readiness")
    except Exception:
        if migration:
            current, current_fingerprint = _config_snapshot()
            if current_fingerprint != original_fingerprint:
                if not _windows_owned_settings_match(command, str(state.get("installed_keyring_dir", ""))):
                    raise ControllerError("hybrid storage rollback conflicts with newer Granted config")
                windows.write_secure_bytes(GRANTED_CONFIG, before)
            _windows_cleanup_new_storage(state)
            write_state(previous_state)
        raise
    print("granted-auto-auth installation resynchronized")


def _windows_install_locked() -> None:
    _windows_prepare_browser_state()
    if _windows_enabled():
        sync_sidecar_runtime()
        print("granted-auto-auth is already installed")
        return
    if STATE_FILE.exists():
        state = read_secure_toml(STATE_FILE)
        phase = state.get("phase")
        if phase == "configured":
            _windows_resynchronize_configured(state)
            return
        if phase == "uninstalling":
            raise ControllerError("existing Windows install requires uninstall or recovery")
        _windows_restore_config(state, require_installed=False)
        _windows_cleanup_new_storage(state)
        STATE_FILE.unlink()
    uv_path = _windows_uv_path()
    before, fingerprint = _config_snapshot()
    if not _windows_keyring_migration_allowed():
        raise ControllerError("Granted Keyring Backend must be absent or wincred before install")
    command = _windows_launch_command(uv_path)
    file_dir, directory_created = _windows_prepare_keyring_directory()
    state = _windows_base_state(before, fingerprint, command, uv_path, file_dir, directory_created)
    write_state(state)
    try:
        _windows_prepare_keyring_credential(state, allow_existing=False)
        chromium, revision = provision_chromium()
        state.update(phase="chromium_ready", chromium_path=chromium, chromium_revision=revision)
        write_state(state)
        _windows_apply_install_config(state, command, file_dir, fingerprint)
    except Exception:
        try:
            _windows_restore_config(state, require_installed=_windows_owned_settings_match(command, file_dir))
            _windows_cleanup_new_storage(state)
            STATE_FILE.unlink(missing_ok=True)
        except Exception:
            pass
        raise
    print("granted-auto-auth installed")


def _windows_install() -> None:
    with _windows_transaction():
        _windows_install_locked()


def _windows_uninstall_locked() -> None:
    state = read_secure_toml(STATE_FILE)
    if state.get("phase") != "configured":
        raise ControllerError("Windows install state is not configured")
    command = state.get("installed_launch_template")
    file_dir = state.get("installed_keyring_dir")
    if not isinstance(command, str) or not isinstance(file_dir, str) or not _windows_owned_settings_match(command, file_dir):
        raise ControllerError("refusing to overwrite unrelated Granted browser or keyring setting")
    state["phase"] = "uninstalling"
    write_state(state)
    _windows_restore_config(state, require_installed=True)
    STATE_FILE.unlink()
    print("granted-auto-auth uninstalled; Chromium, browser profile, encrypted cache, and managed password were preserved")


def _windows_uninstall() -> None:
    with _windows_transaction():
        _windows_uninstall_locked()


def set_custom_browser(value: str) -> None:
    run_checked(["granted", "settings", "set", "--setting", "CustomSSOBrowserPath", "--value", value], capture=True)
    if custom_sso_browser_path() != value:
        raise ControllerError("Granted browser setting did not persist")


def base_state(previous: str) -> dict[str, object]:
    return {
        "phase": "prepared",
        "previous_browser_path": previous,
        "executable_path": str(SIDECAR),
        "chromium_path": "",
        "playwright_version": PLAYWRIGHT_VERSION,
        "chromium_revision": "",
    }


def _owned_sidecar_path(value: object) -> bool:
    if not isinstance(value, str):
        return False
    path = Path(value)
    return path.is_absolute() and path.parent == SCRIPTS_DIR and path.name.startswith("granted_auto_") and path.suffix == ".py"


def migrate_install_state() -> bool:
    if not STATE_FILE.exists():
        return False
    state = read_secure_toml(STATE_FILE)
    executable = state.get("executable_path")
    if executable == str(SIDECAR):
        return False
    if state.get("phase") != "configured" or not _owned_sidecar_path(executable):
        return False
    current = custom_sso_browser_path()
    if current not in {executable, str(SIDECAR)}:
        raise ControllerError("configured install state does not match Granted")
    sync_sidecar_runtime()
    if current != str(SIDECAR):
        set_custom_browser(str(SIDECAR))
    state["executable_path"] = str(SIDECAR)
    write_state(state)
    return enabled()


def recover_install_state() -> str:
    if not STATE_FILE.exists():
        return custom_sso_browser_path()
    state = read_secure_toml(STATE_FILE)
    executable = state.get("executable_path")
    if executable != str(SIDECAR) and not _owned_sidecar_path(executable):
        raise ControllerError("install state belongs to another executable")
    previous = state.get("previous_browser_path")
    if not isinstance(previous, str):
        raise ControllerError("saved browser setting is invalid")
    current = custom_sso_browser_path()
    phase = state.get("phase")
    if phase == "configured":
        if current != executable:
            raise ControllerError("configured install state does not match Granted")
        return previous
    if phase not in {"prepared", "chromium_ready", "uninstalling"}:
        raise ControllerError("install state phase is invalid")
    if current == executable:
        set_custom_browser(previous)
    elif current != previous:
        raise ControllerError("partial install conflicts with Granted browser setting")
    STATE_FILE.unlink()
    return previous


def rollback_install(previous: str) -> None:
    current = custom_sso_browser_path()
    if current == str(SIDECAR):
        set_custom_browser(previous)
    elif current != previous:
        raise ControllerError("failed install conflicts with Granted browser setting")
    STATE_FILE.unlink(missing_ok=True)


def sync_sidecar_runtime() -> None:
    if not SIDECAR.is_file() or not LOCKFILE.is_file() or (os.name == "nt" and (not SUPERVISOR.is_file() or not SUPERVISOR_LOCKFILE.is_file())):
        raise ControllerError("sidecar, supervisor, or script lock is missing")
    uv = _windows_uv_path() if os.name == "nt" else "uv"
    sidecar = windows.canonical_path(SIDECAR) if os.name == "nt" else str(SIDECAR)
    run_checked([uv, "lock", "--check", "--script", sidecar])
    run_checked([uv, "sync", "--locked", "--script", sidecar])
    if os.name == "nt":
        supervisor = windows.canonical_path(SUPERVISOR)
        run_checked([uv, "lock", "--check", "--script", supervisor])
        run_checked([uv, "sync", "--locked", "--script", supervisor])


def provision_chromium() -> tuple[str, str]:
    sync_sidecar_runtime()
    uv = _windows_uv_path() if os.name == "nt" else "uv"
    run_checked([uv, "run", "--with", f"playwright=={PLAYWRIGHT_VERSION}", "playwright", "install", "chromium"])
    probe = run_checked(
        [
            uv,
            "run",
            "--offline",
            "--with",
            f"playwright=={PLAYWRIGHT_VERSION}",
            "python",
            "-c",
            "from playwright.sync_api import sync_playwright; p=sync_playwright().start(); print(p.chromium.executable_path); p.stop()",
        ],
        capture=True,
    )
    chromium = probe.stdout.strip()
    path = Path(chromium)
    if not _windows_executable(path):
        raise ControllerError("provisioned Chromium executable is missing")
    revision_match = re.search(r"chromium-[^/]*?(\d+)", chromium)
    revision = revision_match.group(1) if revision_match else path.parent.name
    return chromium, revision


def _darwin_process_health() -> list[str]:
    try:
        library = ctypes.CDLL("/usr/lib/libproc.dylib")
        library.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]
        library.proc_pidinfo.restype = ctypes.c_int
        library.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]
        library.proc_pidpath.restype = ctypes.c_int
        info = ctypes.create_string_buffer(136)
        path = ctypes.create_string_buffer(4096)
        if library.proc_pidinfo(os.getpid(), 3, 0, info, len(info)) != len(info):
            return ["Darwin libproc process-info probe failed"]
        if library.proc_pidpath(os.getpid(), path, len(path)) <= 0:
            return ["Darwin libproc process-path probe failed"]
    except (AttributeError, OSError):
        return ["Darwin libproc process backend is unavailable"]
    return []


def _linux_process_health() -> list[str]:
    try:
        release = OS_RELEASE.read_text()
        distro = next(
            (line.split("=", 1)[1].strip().strip('"') for line in release.splitlines() if line.startswith("ID=")), ""
        )
        if distro != "ubuntu":
            return ["unsupported Linux distribution: Ubuntu is required"]
        raw = (PROC_ROOT / "self/stat").read_text()
        tail = raw[raw.rfind(")") + 2 :].split()
        if len(tail) < 20 or int(tail[1]) < 0 or not tail[19]:
            return ["Linux /proc process-info probe failed"]
        executable = os.path.realpath(os.readlink(PROC_ROOT / "self/exe"))
        if not Path(executable).is_file() or not os.access(executable, os.X_OK):
            return ["Linux /proc process-path probe failed"]
    except (OSError, ValueError):
        return ["Linux /proc process backend is unavailable"]
    return []


def _busctl(arguments: list[str]) -> str:
    executable = shutil.which("busctl")
    if not executable:
        raise ControllerError("busctl is unavailable")
    try:
        result = subprocess.run(
            [executable, "--user", "--timeout=400ms", *arguments],
            check=True,
            text=True,
            capture_output=True,
            timeout=0.5,
        )
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError) as error:
        raise ControllerError("Secret Service D-Bus probe failed") from error
    return result.stdout.strip()


def _secret_service_process(pid: int) -> tuple[str, int]:
    process = PROC_ROOT / str(pid)
    return os.path.realpath(os.readlink(process / "exe")), process.stat().st_uid


def _secret_service_health() -> list[str]:
    try:
        owner_output = _busctl(
            ["call", "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetNameOwner", "s", "org.freedesktop.secrets"]
        )
    except ControllerError:
        return ["Secret Service is unavailable; start a user D-Bus session and gnome-keyring-daemon or ksecretd"]
    owner_match = re.fullmatch(r's\s+"(:[0-9.]+)"', owner_output)
    if not owner_match:
        return ["Secret Service owner response is invalid; restart the supported wallet"]
    owner = owner_match.group(1)
    try:
        pid_output = _busctl(
            ["call", "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetConnectionUnixProcessID", "s", owner]
        )
        pid_match = re.fullmatch(r"u\s+(\d+)", pid_output)
        if not pid_match:
            return ["Secret Service owner PID response is invalid; restart the supported wallet"]
        executable, uid = _secret_service_process(int(pid_match.group(1)))
    except (ControllerError, OSError, ValueError):
        return ["Secret Service owner process is unavailable; restart the supported wallet"]
    if Path(executable).name not in {"gnome-keyring-daemon", "ksecretd"} or uid != os.getuid():
        return [
            "Secret Service owner must be the user's gnome-keyring-daemon or ksecretd; "
            "start a supported wallet and unlock its default collection"
        ]
    try:
        locked = _busctl(
            ["get-property", owner, "/org/freedesktop/secrets/aliases/default", "org.freedesktop.Secret.Collection", "Locked"]
        )
    except ControllerError:
        return [
            "Secret Service default collection is unavailable; configure and unlock a default collection "
            "in the supported wallet"
        ]
    if locked == "b true":
        return ["Secret Service default collection is locked; unlock the default collection in the supported wallet"]
    if locked != "b false":
        return ["Secret Service default collection lock response is invalid; restart the supported wallet"]
    return []


def platform_health() -> list[str]:
    if os.name == "nt":
        failures: list[str] = []
        if sys.maxsize <= 2**32:
            failures.append("Windows x64 Python is required")
        try:
            windows.current_sid_string()
        except OSError:
            failures.append("Windows security APIs are unavailable")
        return failures
    if sys.platform == "darwin":
        return _darwin_process_health()
    if sys.platform.startswith("linux"):
        failures = _linux_process_health()
        if failures:
            return failures
        return _secret_service_health()
    return [f"unsupported process platform: {sys.platform}"]


def enabled() -> bool:
    if os.name == "nt":
        return _windows_enabled()
    try:
        state = read_secure_toml(STATE_FILE)
        chromium = str(state.get("chromium_path", ""))
        revision = str(state.get("chromium_revision", ""))
        return all(
            (
                state.get("phase") == "configured",
                state.get("executable_path") == str(SIDECAR),
                state.get("playwright_version") == PLAYWRIGHT_VERSION,
                custom_sso_browser_path() == str(SIDECAR),
                SIDECAR.is_file() and os.access(SIDECAR, os.X_OK),
                LOCKFILE.is_file(),
                isinstance(state.get("chromium_path"), str),
                isinstance(state.get("chromium_revision"), str) and bool(revision),
                f"chromium-{revision}" in chromium,
                Path(chromium).is_file(),
                os.access(chromium, os.X_OK),
                not platform_health(),
            )
        )
    except (ControllerError, FileNotFoundError, PermissionError, tomllib.TOMLDecodeError, OSError):
        return False


def install() -> None:
    if os.name == "nt":
        _windows_install()
        return
    if enabled():
        sync_sidecar_runtime()
        print("granted-auto-auth is already installed")
        return
    if migrate_install_state():
        print("granted-auto-auth installation migrated")
        return
    previous = recover_install_state()
    state = base_state(previous)
    write_state(state)
    try:
        chromium, revision = provision_chromium()
        state.update(phase="chromium_ready", chromium_path=chromium, chromium_revision=revision)
        write_state(state)
        set_custom_browser(str(SIDECAR))
        state["phase"] = "configured"
        write_state(state)
    except Exception:
        try:
            rollback_install(previous)
        except ControllerError:
            pass
        raise
    print("granted-auto-auth installed")


def uninstall() -> None:
    if os.name == "nt":
        _windows_uninstall()
        return
    state = read_secure_toml(STATE_FILE)
    expected = state.get("executable_path")
    if not _owned_sidecar_path(expected) or custom_sso_browser_path() != expected:
        raise ControllerError("refusing to overwrite unrelated Granted browser setting")
    state["phase"] = "uninstalling"
    write_state(state)
    previous = state.get("previous_browser_path")
    if not isinstance(previous, str):
        raise ControllerError("saved browser setting is invalid")
    set_custom_browser(previous)
    STATE_FILE.unlink()
    print("granted-auto-auth uninstalled; Chromium and browser profile were preserved")


def _credential_health() -> list[str]:
    failures: list[str] = []
    try:
        values = read_secure_toml(CREDENTIALS_FILE)
        for field in ("username", "password", "totp_secret", "idp"):
            if not isinstance(values.get(field), str) or not str(values[field]).strip():
                failures.append(f"credential field missing: {field}")
    except (ControllerError, FileNotFoundError, tomllib.TOMLDecodeError, OSError) as error:
        failures.append(str(error))
    return failures


def _legacy_profiles() -> list[str]:
    try:
        text = AWS_CONFIG.read_text()
    except OSError:
        return []
    current = ""
    legacy: list[str] = []
    has_start = False
    has_session = False
    for line in [*text.splitlines(), "[end]"]:
        section = re.match(r"^\[([^]]+)\]$", line.strip())
        if section:
            if current and has_start and not has_session:
                legacy.append(current)
            section_name = section.group(1)
            profile = re.fullmatch(r"profile (.+)", section_name)
            if section_name == "default":
                current = "default"
            elif profile:
                current = profile.group(1)
            else:
                current = ""
            has_start = False
            has_session = False
        elif current and re.match(r"^\s*sso_start_url\s*=", line):
            has_start = True
        elif current and re.match(r"^\s*sso_session\s*=", line):
            has_session = True
    return legacy


def doctor() -> int:
    failures = _credential_health()
    warnings: list[str] = []
    try:
        version = run_checked(["granted", "--version"], capture=True).stdout.strip()
        if "0.39." not in version:
            failures.append("Granted v0.39.x is required; install a Granted v0.39.x release")
        config = granted_config()
        if config.get("UseAuthorizationCode") is not True:
            failures.append(
                "UseAuthorizationCode must be true; run: granted settings set --setting UseAuthorizationCode --value true"
            )
        if config.get("DisableCredentialProcessCache", False) is not False:
            failures.append(
                "DisableCredentialProcessCache must be false; run: granted settings set --setting "
                "DisableCredentialProcessCache --value false"
            )
        if os.name == "nt":
            keyring = config.get("Keyring")
            if not isinstance(keyring, dict) or keyring.get("Backend") != "file":
                failures.append("Granted Keyring Backend must be file on Windows; run: granted-auto-auth install")
            try:
                expected_keyring_dir = windows.canonical_path(KEYRING_DIR)
                if isinstance(keyring, dict) and keyring.get("Backend") == "file" and not _windows_keyring_matches(expected_keyring_dir):
                    failures.append("Granted Keyring FileDir is not managed by granted-auto-auth")
                credential = windows.credential_read(KEYRING_CREDENTIAL_TARGET)
                if not credential:
                    failures.append("managed Windows keyring password is missing; run: granted-auto-auth install")
                handle = windows.secure_open(KEYRING_DIR, directory=True)
                windows.close_handle(handle)
            except (OSError, PermissionError):
                failures.append("managed Windows keyring storage is unavailable or unsafe")
    except ControllerError as error:
        failures.append(str(error))
    failures.extend(platform_health())
    if not enabled():
        failures.append("installation is not enabled; run: granted-auto-auth install")
    browser_dir = Path.home() / ".local/share/granted-auto-auth/browser"
    if browser_dir.exists():
        if os.name == "nt":
            try:
                handle = windows.secure_open(browser_dir, directory=True)
                windows.close_handle(handle)
            except (OSError, PermissionError):
                failures.append("browser profile ACL or reparse state is unsafe")
        elif browser_dir.stat().st_uid != os.getuid() or stat.S_IMODE(browser_dir.stat().st_mode) & ~0o700:
            failures.append("browser profile permissions are too permissive")
    legacy = _legacy_profiles()
    if legacy:
        warnings.append(f"legacy inline SSO profiles detected: {len(legacy)}")
    if CONTAINER_MARKER.exists():
        warnings.append("container detected: Granted may use device flow with legacy scopes")
    for warning in warnings:
        print(f"WARN: {warning}")
    for failure in failures:
        print(f"FAIL: {failure}")
    if failures:
        return 1
    print("OK: granted-auto-auth is ready")
    return 0


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] not in {"doctor", "enabled", "install", "uninstall"}:
        print("usage: granted-auto-auth doctor|enabled|install|uninstall", file=sys.stderr)
        return 2
    command = argv[0]
    try:
        if command == "enabled":
            return 0 if enabled() else 1
        if command == "doctor":
            return doctor()
        if command == "install":
            install()
        else:
            uninstall()
        return 0
    except (ControllerError, FileNotFoundError, PermissionError, tomllib.TOMLDecodeError, OSError) as error:
        print(f"granted-auto-auth: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
